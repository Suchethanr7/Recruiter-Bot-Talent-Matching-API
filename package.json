{
  "name": "recruiter-bot",
  "version": "1.0.0",
  "description": "AI-Enhanced Candidate Matching Engine — RecruiterFlow Engineering Internship Assignment",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/scoring.test.ts tests/semantic-matching.test.ts",
    "test:api": "node --import tsx --test tests/api.test.ts",
    "test:all": "node --import tsx --test tests/scoring.test.ts tests/semantic-matching.test.ts tests/api.test.ts",
    "seed": "tsx scripts/seed.ts",
    "evaluate": "tsx scripts/evaluate-semantic-matching.ts"
  },
  "keywords": ["recruiting", "matching", "ai", "embeddings"],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "mysql2": "^3.11.0"
  }
}
