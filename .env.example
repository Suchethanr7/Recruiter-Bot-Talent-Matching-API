# Environment
NODE_ENV=development
PORT=3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=recruiterflow

# Semantic Matching
SEMANTIC_MATCHING_ENABLED=true

# Embedding Provider (google-ai | openai)
EMBEDDING_PROVIDER=google-ai

# Google AI (Gemini) Embedding — recommended for this assignment
# Get a free API key at https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# OpenAI Embedding — alternative provider
# OPENAI_API_KEY=your_openai_api_key_here

# Semantic matching configuration
SEMANTIC_SIMILARITY_THRESHOLD=0.82
EMBEDDING_CACHE_MAX_SIZE=500
EMBEDDING_REQUEST_TIMEOUT_MS=10000

